    <path
        android:fillColor="#FF5D97"
        android:pathData="M 18,48 a 6,6 0 1 1 -0.1,0 Z" />
    <!-- keyhole: ring of secrecy -->
    <path
        android:fillColor="#FFF3F7"
        android:pathData="M 54,39 a 11,11 0 1 1 -0.1,0 Z" />
    <path
        android:fillColor="#FFF3F7"
